<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras"
             BackgroundColor="{StaticResource Gray100}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Relatório" Clicked="ToolbarItem_Relatorio_Clicked" />
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *" Margin="12">
        <!-- Filtro por Categoria -->
        <Picker x:Name="picker_filtro" 
                Grid.Row="0" 
                Title="Filtrar por Categoria" 
                SelectedIndexChanged="picker_filtro_SelectedIndexChanged"
                Margin="0,0,0,8">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Todas as Categorias</x:String>
                    <x:String>Alimentos</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                    <x:String>Outros</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <!-- Barra de Pesquisa -->
        <SearchBar x:Name="txt_search" 
                   Grid.Row="1" 
                   Placeholder="Pesquisar produtos..." 
                   TextChanged="txt_search_TextChanged"
                   Margin="0,0,0,10" />

        <!-- Lista de Produtos -->
        <Frame Grid.Row="2" 
               Padding="0" 
               CornerRadius="12" 
               HasShadow="True" 
               BackgroundColor="{StaticResource White}"
               VerticalOptions="FillAndExpand">

            <ListView x:Name="lst_produtos" 
                      ItemSelected="lst_produtos_ItemSelected" 
                      IsPullToRefreshEnabled="True" 
                      Refreshing="lst_produtos_Refreshing"
                      SeparatorVisibility="Default">

                <ListView.Header>
                    <Grid ColumnDefinitions="40, *, 70, 50, 80"
                          BackgroundColor="{StaticResource Gray200}"
                          Padding="10, 8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" FontSize="12"/>
                        <Label Grid.Column="1" Text="Descrição" FontAttributes="Bold" FontSize="12"/>
                        <Label Grid.Column="2" Text="Preço" FontAttributes="Bold" FontSize="12"/>
                        <Label Grid.Column="3" Text="Qtd" FontAttributes="Bold" FontSize="12"/>
                        <Label Grid.Column="4" Text="Total" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="End"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover" Clicked="MenuItem_Clicked"/>
                            </ViewCell.ContextActions>

                            <Grid ColumnDefinitions="40, *, 70, 50, 80" Padding="10, 12" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{Binding Id}" FontSize="13" TextColor="{StaticResource Gray600}"/>
                                <Label Grid.Column="1" Text="{Binding Descriçao}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                                <Label Grid.Column="2" Text="{Binding Preço, StringFormat='{}{0:c}'}" FontSize="13" TextColor="{StaticResource Gray600}"/>
                                <Label Grid.Column="3" Text="{Binding Quantidade}" FontSize="13" TextColor="{StaticResource Gray600}"/>
                                <Label Grid.Column="4" Text="{Binding Total, StringFormat='{}{0:c}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
    </Grid>
</ContentPage>