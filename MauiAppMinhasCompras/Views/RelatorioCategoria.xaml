<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioCategoria"
             Title="Relatório por Categoria"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="*" Margin="12">
        <Frame Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="{StaticResource White}">
            <ListView x:Name="lst_relatorio" SeparatorVisibility="Default">
                <ListView.Header>
                    <Grid ColumnDefinitions="*, 120" BackgroundColor="{StaticResource Gray200}" Padding="15, 10">
                        <Label Grid.Column="0" Text="Categoria" FontAttributes="Bold" FontSize="14"/>
                        <Label Grid.Column="1" Text="Total Gasto" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="End"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="*, 120" Padding="15, 12" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{Binding Categoria}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                                <Label Grid.Column="1" Text="{Binding TotalGasto, StringFormat='{}{0:c}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
    </Grid>
</ContentPage>